# --- Pro Hiring Solutions API ---

# Port (Render sets this automatically; 8080 for local dev)
PORT=8080

# Google Apps Script Web App URL that appends rows to your Google Sheet.
# See google-apps-script.gs and DEPLOY.md for setup.
SHEETS_WEBHOOK_URL=

# Optional shared secret. Must match SECRET in the Apps Script.
SHEETS_WEBHOOK_TOKEN=

# Comma-separated allowed origins (your Vercel URLs). Leave blank in dev.
# Example: https://prohiringsolutions.com,https://pro-hiring-solutions.vercel.app
ALLOWED_ORIGINS=
